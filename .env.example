# --- WhatsApp Cloud API (Meta) ---
# Se obtienen en developers.facebook.com > tu app > WhatsApp > API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Token que tú inventas y pones también en la configuración del webhook en Meta
WHATSAPP_VERIFY_TOKEN=

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=

# --- Supervisora ---
# Número en formato internacional sin "+" ni espacios, ej: 56912345678
SUPERVISORA_WHATSAPP_NUMBER=

# --- Servidor ---
PORT=3000
